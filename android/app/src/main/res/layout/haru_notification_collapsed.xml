<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/haru_notification_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_collapsed_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="HARU · 근무 중"
            android:textColor="#242033"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_collapsed_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="퇴근까지 01:19 · 진행률 90%"
            android:textColor="#676273"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/notification_collapsed_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="2dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="50"
            android:progressBackgroundTint="#E8E3F4"
            android:progressTint="#7565C8" />
    </LinearLayout>

    <ImageView
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginStart="7dp"
        android:contentDescription="HARU"
        android:src="@drawable/haru_pixel_cat" />
</LinearLayout>
