<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockscreen_dayve_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/haru_notification_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DAYVE"
        android:textColor="#6E5DE3"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="오늘의 일과"
        android:textColor="#17141F"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="오늘도 조금씩, 좋은 하루가 되고 있어요"
        android:textColor="#817C90"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/dayve_notification_progress_panel"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="◷  오늘의 하루 진행률"
                android:textColor="#6E5DE3"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_expanded_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/dayve_notification_badge"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="52%"
                android:textColor="#6E5DE3"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_expanded_encouragement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="오후도 화이팅!"
                android:textColor="#817C90"
                android:textSize="9sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:clipChildren="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_gravity="bottom"
                android:background="@drawable/dayve_notification_gauge_outer"
                android:padding="3dp">

                <ProgressBar
                    android:id="@+id/notification_expanded_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/dayve_notification_progress" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:translationY="3dp">
            <LinearLayout android:id="@+id/notification_cat_position_0" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="오늘 하루를 밀어주는 DAYVE 고양이" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="10" /></LinearLayout>
            <LinearLayout android:id="@+id/notification_cat_position_1" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="9" /></LinearLayout>
            <LinearLayout android:id="@+id/notification_cat_position_2" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="8" /></LinearLayout>
            <LinearLayout android:id="@+id/notification_cat_position_3" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="3" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="7" /></LinearLayout>
            <LinearLayout android:id="@+id/notification_cat_position_4" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" /></LinearLayout>
            <LinearLayout android:id="@+id/notification_cat_position_5" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="5" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="5" /></LinearLayout>
            <LinearLayout android:id="@+id/notification_cat_position_6" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4" /></LinearLayout>
            <LinearLayout android:id="@+id/notification_cat_position_7" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="7" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="3" /></LinearLayout>
            <LinearLayout android:id="@+id/notification_cat_position_8" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="8" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" /></LinearLayout>
            <LinearLayout android:id="@+id/notification_cat_position_9" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="9" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" /></LinearLayout>
            <LinearLayout android:id="@+id/notification_cat_position_10" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone"><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="10" /><ImageView android:layout_width="40dp" android:layout_height="40dp" android:scaleType="fitCenter" android:src="@drawable/dayve_pixel_cat" /><FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" /></LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notification_expanded_leading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="오전은 수고했어요!"
                android:textColor="#817C90"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/notification_expanded_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="퇴근까지 02:00"
                android:textColor="#817C90"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
